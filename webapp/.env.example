# Copy to .env.local and fill in. The webapp uses the same backend and database as the mobile app.

# AstroShrine Express API (app-backend). Server-side only: the browser calls /api/v1/... and
# Next.js forwards it here, so the backend's CORS list does not need the web origin.
# Production: https://app-backend-production-a782.up.railway.app  ·  Local backend: http://localhost:5050
BACKEND_URL=

# The website's own origin, for absolute share-image URLs (og:image). Example: https://app.astroshrine.in
NEXT_PUBLIC_SITE_URL=

# Supabase project the backend uses (Dashboard -> Project Settings -> API). Public client values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Realtime chat: the backend's own WebSocket (/ws/realtime), the one the app uses. Browsers connect to it directly
# (Next.js cannot proxy WebSocket upgrades), so it is public. Same host as BACKEND_URL with ws(s)://.
# Production: wss://app-backend-production-a782.up.railway.app  ·  Local backend: ws://localhost:5050
# Without it chat still works, with messages fetched every 20 s instead of instantly.
NEXT_PUBLIC_BACKEND_WS_URL=
