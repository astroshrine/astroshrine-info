{
  "headers": [
    {
      "source": ".well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/download",
      "destination": "/home#download",
      "type": 301
    },
    {
      "source": "/download.html",
      "destination": "/home#download",
      "type": 301
    }
  ]
}
